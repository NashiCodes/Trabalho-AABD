{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Iniciar Servidor",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[nodemon\\] starting",
          "endsPattern": "^(Servidor rodando|Conectado ao MongoDB)"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "echo": false,
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "✅ Executar Lint",
      "type": "shell",
      "command": "npm run lint",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "🔧 Executar Lint:Fix",
      "type": "shell",
      "command": "npm run lint:fix",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
